@page "{id:int}"
@model ShopAKA.Pages.ProductDetailModel
@{
    ViewData["Title"] = Model.Product?.ProductName ?? "Chi tiết sản phẩm";
}
@section Styles { <link rel="stylesheet" href="~/css/productdetail.css" /> }

@if (Model.Product != null)
{
    <div class="product-detail-page">
        <div data-product-id="@Model.Product.ProductID" style="display: none;"></div>
        <div class="container" style="max-width: 1200px; margin: 0 auto; padding: 20px;">
            <button type="button" onclick="history.back()" style="background: none; border: none; color: #6c757d; margin-bottom: 30px; cursor: pointer; display: flex; align-items: center; gap: 8px;">
                <i class="fas fa-arrow-left"></i><span>Quay lại</span>
            </button>

            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: start;">
                <div>
                    <div class="product-image-card">
                        @if (!string.IsNullOrEmpty(Model.Product.ProductImage))
                        {
                            <img src="@Model.Product.ProductImage" alt="@Model.Product.ProductName" style="width: 100%; height: 500px; object-fit: contain; background: #f8f9fa;" data-product-image />
                        }
                        else
                        {
                            <div style="width: 100%; height: 400px; display: flex; align-items: center; justify-content: center; background: #f8f9fa;">
                                <p style="color: #6c757d;">Chưa có hình ảnh</p>
                            </div>
                        }
                    </div>
                    <div class="feature-buttons">
                        <div class="feature-btn"><div style="font-size: 20px; margin-bottom: 8px;">🚚</div><p style="margin: 0; font-size: 14px; font-weight: 500;">Giao hàng nhanh</p></div>
                        <div class="feature-btn"><div style="font-size: 20px; margin-bottom: 8px;"><i class="fas fa-shield-alt"></i></div><p style="margin: 0; font-size: 14px; font-weight: 500;">Uy tín</p></div>
                    </div>
                </div>

                <div>
                    <div class="product-info-card">
                        <h1 style="font-size: 24px; font-weight: bold; margin: 0 0 16px 0; color: #212529;" data-product-name>@Model.Product.ProductName</h1>
                        @if (Model.Product.Category != null)
                        {
                            <div style="margin-bottom: 16px;">
                                <span style="background: #fff3cd; color: #856404; padding: 4px 12px; border-radius: 16px; font-size: 12px; font-weight: 500;">@Model.Product.Category.CategoryName</span>
                            </div>
                        }
                        <div style="margin-bottom: 16px;">
                            <p style="font-size: 28px; font-weight: bold; color: #28a745; margin: 0;" data-product-price>@string.Format("{0:N0}", Model.Product.ProductPrice)₫</p>
                            <p style="color: #6c757d; font-size: 14px; margin: 0;">Giá đã bao gồm thuế</p>
                        </div>
                        @if (!string.IsNullOrEmpty(Model.Product.ProductDecription))
                        {
                            <div style="margin-bottom: 24px;">
                                <h3 style="font-size: 18px; font-weight: 600;">Mô tả sản phẩm</h3>
                                <p style="color: #495057; line-height: 1.6;">@Model.Product.ProductDecription</p>
                            </div>
                        }
                        <div style="margin-bottom: 24px;">
                            <h3 style="font-size: 18px; font-weight: 600;">Số lượng</h3>
                            <div style="display: flex; align-items: center; gap: 24px;">
                                <div class="quantity-selector">
                                    <button type="button" onclick="decreaseQuantity()" class="quantity-btn"><i class="fas fa-minus"></i></button>
                                    <span id="quantity" class="quantity-display">1</span>
                                    <button type="button" onclick="increaseQuantity()" class="quantity-btn"><i class="fas fa-plus"></i></button>
                                </div>
                                <div>
                                    <p style="font-size: 14px; font-weight: 500; margin: 0;">Tổng cộng:</p>
                                    <p id="totalPrice" style="font-size: 20px; font-weight: bold; color: #28a745; margin: 0;">@string.Format("{0:N0}", Model.Product.ProductPrice)₫</p>
                                </div>
                                <div>
                                    <p style="font-size: 14px; font-weight: 500; margin: 0;">Số lượng tồn:</p>
                                    <p id="stockQuantity" style="font-size: 16px; font-weight: bold; color: @(Model.Product.StockQuantity > 0 ? "#28a745" : "#dc3545"); margin: 0;" data-product-stock="@Model.Product.StockQuantity">@Model.Product.StockQuantity sản phẩm</p>
                                </div>
                            </div>
                        </div>
                        <div>
                            <button type="button" onclick="buyNow()" class="buy-now-btn"><i class="fas fa-bolt" style="margin-right: 8px;"></i>Mua ngay</button>
                            <button type="button" onclick="addToCart()" class="add-cart-btn"><i class="fas fa-shopping-cart" style="margin-right: 8px;"></i>Thêm vào giỏ hàng</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="container py-5 text-center">
        <h2>Sản phẩm không tồn tại</h2>
        <a asp-page="/Index" class="btn btn-primary mt-3"><i class="fas fa-arrow-left me-2"></i>Quay lại trang chủ</a>
    </div>
}

@section Scripts { <script src="~/js/ProductDetail.js"></script> }

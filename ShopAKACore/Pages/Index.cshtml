            <div class="col-lg-2 col-md-6 mb-4"><h6 class="footer-subtitle">Sản Phẩm</h6><ul class="footer-links list-unstyled"><li><a href="#">Điện Thoại</a></li><li><a href="#">Laptop</a></li><li><a href="#">Phụ Kiện</a></li><li><a href="#">Đồng Hồ</a></li></ul></div>

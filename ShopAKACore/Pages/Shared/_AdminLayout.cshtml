<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>@ViewData["Title"] - Admin ShopAKA</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link href="~/css/categories.css" rel="stylesheet" />
    @RenderSection("Styles", required: false)
    <style>
        body { display:flex; flex-direction:column; min-height:100vh; }
        .main-content { flex:1; }
        .admin-footer { background:#343a40; color:#fff; padding:20px 0; margin-top:auto; text-align:center; }
    </style>
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark px-3">
        <a class="navbar-brand fw-bold" asp-page="/Admin/Index">Admin Dashboard</a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#adminNavbar"><span class="navbar-toggler-icon"></span></button>
        <div class="collapse navbar-collapse" id="adminNavbar">
            @await Component.InvokeAsync("AdminSidebar", new { activePage = ViewData["ActivePage"] })
            <ul class="navbar-nav ms-auto">
                <li class="nav-item"><a class="nav-link text-warning" asp-page="/Index"><i class="fa fa-home"></i> Trang khách</a></li>
                <li class="nav-item"><a class="nav-link" asp-page="/Admin/Logout"><i class="fa fa-sign-out-alt"></i> Đăng xuất</a></li>
            </ul>
        </div>
    </nav>
    <div class="container mt-4 main-content">@RenderBody()</div>
    <footer class="admin-footer"><p>&copy; 2025 | AKAShop (.NET Core)</p></footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    @RenderSection("Scripts", required: false)
</body>
</html>

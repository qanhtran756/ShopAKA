@model IEnumerable<ShopAKA.Models.Order>
@{
    var showActions = ViewData["ShowActions"] as bool? ?? false;
}

@if (Model != null && Model.Any())
{
    <table class="table category-table">
        <thead>
            <tr>
                <th>Mã đơn hàng</th>
                <th>Ngày đặt</th>
                <th>Tổng tiền</th>
                <th>Trạng thái thanh toán</th>
                <th>Địa chỉ giao hàng</th>
                @if (showActions)
                {
                    <th>Thao tác</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model)
            {
                var paymentStatusClass = item.PaymentStatus?.ToLower() is "đã thanh toán" or "paid"
                    ? "background: #d4edda; color: #155724;"
                    : "background: #f8d7da; color: #721c24;";
                <tr>
                    <td><span class="category-name">#@item.OrderID.ToString("D6")</span></td>
                    <td>@item.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                    <td><span style="color: #28a745; font-weight: 600;">@string.Format("{0:N0}", item.TotalAmount) đ</span></td>
                    <td>
                        <span style="@paymentStatusClass padding: 4px 12px; border-radius: 16px; font-size: 12px; font-weight: 500;">
                            @(item.PaymentStatus ?? "Chưa thanh toán")
                        </span>
                    </td>
                    <td>@(item.AddressDelivery ?? "N/A")</td>
                    @if (showActions)
                    {
                        <td>
                            <a asp-page="/OrderDetail" asp-route-id="@item.OrderID" class="btn btn-sm btn-outline-primary">
                                <i class="fas fa-eye"></i> Xem chi tiết
                            </a>
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="empty-state">
        <i class="fa fa-inbox"></i>
        <p>@(ViewData["EmptyMessage"] ?? "Chưa có đơn hàng nào")</p>
    </div>
}

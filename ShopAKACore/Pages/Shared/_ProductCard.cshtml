@model ShopAKA.Models.Product

<div class="col-lg-3 col-md-4 col-sm-6 mb-4">
    <div class="product-card" data-product-id="@Model.ProductID" data-product-name="@Model.ProductName" data-product-price="@Model.ProductPrice" data-product-stock="@Model.StockQuantity">
        <div class="product-image">
            <img src="@(string.IsNullOrEmpty(Model.ProductImage) ? "/images/no-image.jpg" : Model.ProductImage)" alt="@Model.ProductName" class="img-fluid" data-product-image="@Model.ProductImage">
            <div class="product-overlay">
                <a asp-page="/ProductDetail" asp-route-id="@Model.ProductID" class="btn btn-sm btn-outline-light"><i class="fas fa-eye"></i> Xem chi tiết</a>
            </div>
        </div>
        <div class="product-info">
            <h5 class="product-name" data-product-name="@Model.ProductName">@Model.ProductName</h5>
            @if (!string.IsNullOrEmpty(Model.ProductDecription))
            {
                <p class="product-description">@(Model.ProductDecription.Length > 50 ? Model.ProductDecription[..50] + "..." : Model.ProductDecription)</p>
            }
            <div class="product-price-stock d-flex justify-content-between align-items-center">
                <div class="product-price" data-product-price="@Model.ProductPrice">@Model.ProductPrice.ToString("N0")₫</div>
                <small class="text-muted product-stock" data-product-stock="@Model.StockQuantity"><i class="fas fa-box"></i> Còn lại: @Model.StockQuantity</small>
            </div>
            <div class="product-actions mt-3">
                <button type="button" class="btn btn-sm btn-primary" onclick="buyNow(@Model.ProductID)" data-product-id="@Model.ProductID"><i class="fas fa-shopping-cart"></i> Mua</button>
                <button type="button" class="btn btn-sm btn-outline-primary" onclick="addToCart(@Model.ProductID, true)" data-product-id="@Model.ProductID"><i class="fas fa-cart-plus"></i> Thêm vào giỏ</button>
            </div>
        </div>
    </div>
</div>

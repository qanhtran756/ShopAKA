@page
@model ShopAKA.Pages.SearchModel
@{
    ViewData["Title"] = "Tìm kiếm";
}
<div class="py-4">
    <div class="text-center mb-4">
        <h2 class="section-title">Kết quả tìm kiếm</h2>
        @if (!string.IsNullOrWhiteSpace(Model.Query))
        {
            <p class="text-muted">Từ khóa: "<strong>@Model.Query</strong>" — @Model.TotalResults kết quả</p>
        }
    </div>
    @if (Model.Products.Any())
    {
        <div class="row">
            @foreach (var p in Model.Products)
            {
                @await Html.PartialAsync("_ProductCard", p)
            }
        </div>
        @if (Model.TotalPages > 1)
        {
            <nav class="mt-4"><ul class="pagination justify-content-center">
                @if (Model.CurrentPage > 1)
                {
                    <li class="page-item"><a class="page-link" asp-page="/Search" asp-route-query="@Model.Query" asp-route-page="@(Model.CurrentPage - 1)">Trước</a></li>
                }
                @for (var i = 1; i <= Model.TotalPages; i++)
                {
                    <li class="page-item @(i == Model.CurrentPage ? "active" : "")"><a class="page-link" asp-page="/Search" asp-route-query="@Model.Query" asp-route-page="@i">@i</a></li>
                }
                @if (Model.CurrentPage < Model.TotalPages)
                {
                    <li class="page-item"><a class="page-link" asp-page="/Search" asp-route-query="@Model.Query" asp-route-page="@(Model.CurrentPage + 1)">Sau</a></li>
                }
            </ul></nav>
        }
    }
    else if (!string.IsNullOrWhiteSpace(Model.Query))
    {
        <div class="text-center py-5 text-muted">
            <i class="fas fa-search fa-3x mb-3"></i>
            <p>Không tìm thấy sản phẩm phù hợp.</p>
            <a asp-page="/Index" class="btn btn-primary mt-2">Về trang chủ</a>
        </div>
    }
    else
    {
        <div class="text-center py-5 text-muted"><p>Nhập từ khóa trên thanh tìm kiếm để bắt đầu.</p></div>
    }
</div>

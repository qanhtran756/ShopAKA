@page
@model ShopAKA.Pages.Admin.Users.CreateModel
@{ ViewData["Title"] = "Thêm admin"; }
<h2>Thêm tài khoản admin</h2>
<form method="post">
    <div class="mb-3"><label asp-for="AdminUser.Username" class="form-label"></label><input asp-for="AdminUser.Username" class="form-control" /><span asp-validation-for="AdminUser.Username" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="AdminUser.Password" class="form-label"></label><input asp-for="AdminUser.Password" type="password" class="form-control" /></div>
    <button type="submit" class="btn btn-primary">Lưu</button>
    <a asp-page="Index" class="btn btn-secondary">Hủy</a>
</form>

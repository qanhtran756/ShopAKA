@page
@model ShopAKA.Pages.Admin.Customers.IndexModel
@{ ViewData["Title"] = "Khách hàng"; }
<h2>Quản lý khách hàng</h2>
<table class="table table-striped">
    <thead><tr><th>Tên</th><th>Phone</th><th>Email</th><th>Địa chỉ</th></tr></thead>
    <tbody>@foreach (var c in Model.Customers){<tr><td>@c.CustomerName</td><td>@c.CustomerPhone</td><td>@c.CustomerEmail</td><td>@c.CustomerAddress</td></tr>}</tbody>
</table>

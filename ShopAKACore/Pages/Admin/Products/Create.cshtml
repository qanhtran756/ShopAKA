@page
@model ShopAKA.Pages.Admin.Products.CreateModel
@{ ViewData["Title"] = "Thêm sản phẩm"; }
<h2>Thêm sản phẩm</h2>
<form method="post" enctype="multipart/form-data">
    <div class="mb-3">
        <label asp-for="Product.CategoryID" class="form-label">Danh mục</label>
        <select asp-for="Product.CategoryID" asp-items="Model.CategoryList" class="form-select"></select>
    </div>
    <div class="mb-3">
        <label asp-for="Product.ProductName" class="form-label">Tên sản phẩm</label>
        <input asp-for="Product.ProductName" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Product.ProductDecription" class="form-label">Mô tả</label>
        <textarea asp-for="Product.ProductDecription" class="form-control"></textarea>
    </div>
    <div class="mb-3">
        <label asp-for="Product.ProductPrice" class="form-label">Giá</label>
        <input asp-for="Product.ProductPrice" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="Product.StockQuantity" class="form-label">Tồn kho</label>
        <input asp-for="Product.StockQuantity" class="form-control" />
    </div>
    <div class="mb-3">
        <label asp-for="ImageFile" class="form-label">Ảnh sản phẩm</label>
        <input asp-for="ImageFile" type="file" class="form-control" accept="image/*" />
    </div>
    <button type="submit" class="btn btn-primary">Lưu</button>
    <a asp-page="Index" class="btn btn-secondary">Hủy</a>
</form>

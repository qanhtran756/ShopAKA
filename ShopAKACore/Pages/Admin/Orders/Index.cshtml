@page
@model ShopAKA.Pages.Admin.Orders.IndexModel
@{ ViewData["Title"] = "Đơn hàng"; }
<h2>Quản lý đơn hàng</h2>
<table class="table table-striped">
    <thead><tr><th>Mã</th><th>Khách</th><th>Ngày</th><th>Tổng</th><th>TT</th><th></th></tr></thead>
    <tbody>
    @foreach (var o in Model.Orders)
    {
        <tr>
            <td>#@o.OrderID</td>
            <td>@o.Customer?.CustomerName</td>
            <td>@o.OrderDate.ToString("dd/MM/yyyy")</td>
            <td>@o.TotalAmount.ToString("N0")₫</td>
            <td>@o.PaymentStatus</td>
            <td><a asp-page="Details" asp-route-id="@o.OrderID" class="btn btn-sm btn-info">Chi tiết</a></td>
        </tr>
    }
    </tbody>
</table>
